<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinfu.approval.mapper.SysProcessInstanceMapper">

    <!-- 通用结果映射 -->
    <resultMap id="BaseResultMap" type="com.jinfu.approval.entity.SysProcessInstance">
        <id column="id" property="id"/>
        <result column="template_id" property="templateId"/>
        <result column="template_name" property="templateName"/>
        <result column="form_id" property="formId"/>
        <result column="form_schema_snapshot" property="formSchemaSnapshot"/>
        <result column="form_data" property="formData"/>
        <result column="title" property="title"/>
        <result column="initiator_id" property="initiatorId"/>
        <result column="initiator_name" property="initiatorName"/>
        <result column="dept_id" property="deptId"/>
        <result column="current_step" property="currentStep"/>
        <result column="total_steps" property="totalSteps"/>
        <result column="step_chain_snapshot" property="stepChainSnapshot"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 我的申请 -->
    <select id="selectMyApplications" resultMap="BaseResultMap">
        SELECT * FROM sys_process_instance
        WHERE initiator_id = #{userId}
          AND deleted = 0
        ORDER BY create_time DESC
    </select>

    <!-- 待我审批（我作为 approver 且 node.action='pending' 且 instance.status='pending'） -->
    <select id="selectTodoApprovals" resultMap="BaseResultMap">
        SELECT DISTINCT pi.*
        FROM sys_process_instance pi
        INNER JOIN sys_approval_node an ON an.instance_id = pi.id
        WHERE pi.status = 'pending'
          AND pi.deleted = 0
          AND an.action = 'pending'
          AND an.approver_id = #{userId}
        ORDER BY pi.create_time DESC
    </select>

    <!-- 我已审批 -->
    <select id="selectDoneApprovals" resultMap="BaseResultMap">
        SELECT DISTINCT pi.*
        FROM sys_process_instance pi
        INNER JOIN sys_approval_node an ON an.instance_id = pi.id
        WHERE pi.deleted = 0
          AND an.approver_id = #{userId}
          AND an.action != 'pending'
        ORDER BY an.update_time DESC
    </select>

</mapper>
