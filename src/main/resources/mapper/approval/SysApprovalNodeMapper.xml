<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinfu.approval.mapper.SysApprovalNodeMapper">

    <resultMap id="BaseResultMap" type="com.jinfu.approval.entity.SysApprovalNode">
        <id column="id" property="id"/>
        <result column="instance_id" property="instanceId"/>
        <result column="step_order" property="stepOrder"/>
        <result column="step_name" property="stepName"/>
        <result column="approver_type" property="approverType"/>
        <result column="approver_value" property="approverValue"/>
        <result column="approver_id" property="approverId"/>
        <result column="approver_name" property="approverName"/>
        <result column="action" property="action"/>
        <result column="comment" property="comment"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByInstanceId" resultMap="BaseResultMap">
        SELECT * FROM sys_approval_node
        WHERE instance_id = #{instanceId}
        ORDER BY step_order ASC
    </select>

    <select id="selectPendingByUserId" resultMap="BaseResultMap">
        SELECT * FROM sys_approval_node
        WHERE approver_id = #{userId}
          AND action = 'pending'
        ORDER BY create_time DESC
    </select>

</mapper>
