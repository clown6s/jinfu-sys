# ==============================================
# jinfu-sys 环境变量模板
# 复制为 .env 并填写实际值
# ==============================================

# ---------- 应用版本 ----------
APP_VERSION=1.0.0
APP_PORT=8080

# ---------- 数据库 (外部 MySQL) ----------
DB_URL=jdbc:mysql://your-mysql-host:3306/jinfu_sys?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
DB_USERNAME=jinfu
DB_PASSWORD=your-db-password

# ---------- Redis ----------
REDIS_PASSWORD=your-redis-password
REDIS_DATABASE=0

# ---------- MinIO ----------
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-me-to-a-strong-password
MINIO_BUCKET=jinfu-sys
MINIO_CONSOLE_PORT=9001

# ---------- JWT ----------
# 至少 256 位密钥，生产环境务必修改！
# 生成方式: openssl rand -base64 64
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-256-bits

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://your-frontend-domain.com

# ---------- JVM ----------
# JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ---------- Grafana ----------
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
GRAFANA_PORT=3000

# ---------- Prometheus ----------
PROMETHEUS_PORT=9090

# ---------- Alertmanager ----------
ALERTMANAGER_PORT=9093
# 企业微信 Webhook（告警通知用）
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key-here

# ---------- Loki ----------
LOKI_PORT=3100
