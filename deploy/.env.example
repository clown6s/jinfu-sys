# ==============================================
# jinfu-sys 环境变量模板
# 复制为 .env 并填写实际值
# ==============================================

# ---------- 应用版本 ----------
APP_VERSION=1.0.0
APP_PORT=8080

# ---------- 数据库 (内置 MySQL 8.4) ----------
# 不设置下面三个变量时，app 自动连 compose 内的 mysql 服务
# （库 jinfu_sys，用户 jinfu，默认密码见 compose；生产请务必覆盖 DB_PASSWORD）
DB_URL=jdbc:mysql://mysql:3306/jinfu_sys?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=jinfu
DB_PASSWORD=change-me-db-password
# MySQL root 密码（仅容器内使用，首次初始化生效）
MYSQL_ROOT_PASSWORD=change-me-root-password
# 首次启动自动建 Flowable 表，建好后可设为 false
# FLOWABLE_SCHEMA_UPDATE=true

# ---------- Redis ----------
REDIS_PASSWORD=your-redis-password
REDIS_DATABASE=0

# ---------- MinIO ----------
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-me-to-a-strong-password
MINIO_BUCKET=jinfu-sys
MINIO_CONSOLE_PORT=9001

# ---------- JWT ----------
# 至少 256 位密钥，生产环境务必修改！
# 生成方式: openssl rand -base64 64
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-256-bits

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://your-frontend-domain.com

# ---------- JVM ----------
# JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ---------- Grafana ----------
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
GRAFANA_PORT=3000

# ---------- Prometheus ----------
PROMETHEUS_PORT=9090

# ---------- Alertmanager ----------
ALERTMANAGER_PORT=9093
# 企业微信 Webhook（告警通知用）
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key-here

# ---------- Loki ----------
LOKI_PORT=3100
